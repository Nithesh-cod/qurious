# Copy to .env and fill in. .env is gitignored.
#
# WARNING: Vite inlines VITE_ variables into the client bundle at build time. A key set
# here is readable by anyone who has the built app or the APK. Use it only for a demo
# build with a free-tier key you are willing to rotate. For anything else, leave this
# empty and let each user enter their own key in the app's Settings sheet, which stores
# it in their own browser and never ships it anywhere.

VITE_LLM_PROVIDER=groq
VITE_LLM_MODEL=qwen/qwen3.8-27b
VITE_LLM_API_KEY=
